PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./cloudpulse.db

# How often to check websites, in SECONDS.
#   Under 60: use 5, 10, 15, 20 or 30      (good for testing)
#   60 or more: whole minutes, e.g. 60, 120, 300 (300 = 5 minutes)
CHECK_INTERVAL=30
REQUEST_TIMEOUT=10000
FAILURE_THRESHOLD=2

# true ONLY on your own computer, so you can monitor http://localhost:4000 (test site)
ALLOW_LOCAL_URLS=false

TIMEZONE=Asia/Kolkata

# Leave EMAIL_HOST empty and emails are printed in the terminal instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="CloudPulse <you@example.com>"
